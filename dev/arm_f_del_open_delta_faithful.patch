diff --git a/rectify/core/splice/hp_penalty.py b/rectify/core/splice/hp_penalty.py
index 62b7059..0927e8c 100644
--- a/rectify/core/splice/hp_penalty.py
+++ b/rectify/core/splice/hp_penalty.py
@@ -429,6 +429,204 @@ def _precompute_del_costs(
     return del_costs
 
 
+# ---------------------------------------------------------------------------
+# C1 length-law gap-OPEN cost precomputation (arm-F: the coherent log-odds law
+# wired into the re-placer as a ONE-TIME gap-open discount, NOT a per-base cost)
+# ---------------------------------------------------------------------------
+
+def _precompute_del_open_costs(
+    ref: str,
+    genome_seq: Optional[str],
+    ref_genome_start: int,
+    ref_genome_rev: bool,
+    del_costs: List[float],
+    del_open_table: "HpPenaltyTable",
+    del_open_lam: float,
+    hp_min_run: int = 4,
+    floor: float = 0.05,
+) -> List[float]:
+    """Precompute per-position ONE-TIME deletion gap-OPEN costs for the affine
+    re-placer DP (:func:`_score_hp_affine_del`).
+
+    This is the faithful wiring of the C1 length-law ``del_open_delta`` into the
+    junction re-placer.  The legacy per-position del cost (``del_costs`` — the
+    flat ``del_hp``/``del_normal`` step, the motif-blind arm-B scale) is the
+    baseline; only the run-length DEPENDENCE ``Δ = λ·ln(rate(hp)/rate(1))`` (zero
+    at hp=1, the coherent baseline-anchored log-odds delta from
+    :meth:`HpPenaltyTable.del_open_delta`) is subtracted, ONCE per deletion run
+    (applied at gap-OPEN), leaving gap-EXTEND on the legacy scale.  This is the
+    minimizing-frame analog of C1's "add Δ to the (negative) gap_open" and is the
+    ONLY coherent partial in a global full-consumption DP (see dev/C1_DESIGN.md).
+
+    Contrast with ``penalty_table.del_cost`` (arm-C), which returns the
+    ``penalty_score`` column (a reciprocal-rate heuristic ≈ c/rate_mean, NOT
+    −logP) and is summed additively per base — incoherent in an additive DP.
+
+    Args mirror :func:`_precompute_del_costs`; ``del_costs`` is that function's
+    output (the extend/legacy scale).  Floored at ``floor`` (> 0) so the gap-open
+    never goes negative (a negative open would make the DP fabricate deletions).
+
+    Returns:
+        List of length ``len(ref)`` with per-position gap-OPEN costs.  When
+        ``del_open_lam == 0`` (or the table has no rate_mean → Δ=0) this equals
+        ``del_costs`` exactly, so the affine DP reduces to the linear DP.
+    """
+    R = len(ref)
+    open_costs: List[float] = []
+    for j in range(R):
+        base = ref[j]
+        gp = (ref_genome_start - j) if ref_genome_rev else (ref_genome_start + j)
+        if genome_seq is not None and 0 <= gp < len(genome_seq):
+            run = _hp_run_length(genome_seq, gp)
+            g_base = genome_seq[gp]
+        else:
+            run = 1
+            kk = j - 1
+            while kk >= 0 and ref[kk] == base:
+                run += 1; kk -= 1
+            kk = j + 1
+            while kk < R and ref[kk] == base:
+                run += 1; kk += 1
+            g_base = base
+        delta = (del_open_table.del_open_delta(run, g_base, del_open_lam)
+                 if del_open_table is not None else 0.0)
+        c = del_costs[j] - delta
+        open_costs.append(c if c > floor else floor)
+    return open_costs
+
+
+def _score_hp_affine_del(
+    query: str,
+    ref: str,
+    del_costs: List[float],
+    del_open_costs: List[float],
+    ins_costs: List[float],
+    sub: float = 1.0,
+) -> float:
+    """Semi-global HP-aware alignment with AFFINE deletions + LINEAR insertions.
+
+    Semantics match :func:`junction_scoring._score_hp_anchored` (left end of ref
+    fixed, right suffix free, returns min total cost over all ref end positions),
+    EXCEPT the deletion dimension is affine: a contiguous run of deleted ref
+    bases costs ``del_open_costs[j0]`` for the first base (gap-OPEN, carrying the
+    C1 log-odds discount) plus ``del_costs[j]`` for each subsequent base
+    (gap-EXTEND, legacy scale).  A per-run latch (see the body) makes the gap-OPEN
+    discount ONE-TIME PER HOMOPOLYMER RUN: it cannot be re-collected by bouncing
+    out of a deletion via a free in-run match and re-opening (the staircase the
+    arbiter flagged, which degenerated arm-F to per-base arm-C inside HP runs),
+    yet a genuine run boundary re-arms it so each distinct run earns its own
+    discount.
+
+    When ``del_open_costs == del_costs`` this reduces EXACTLY to the linear DP
+    (a Gotoh affine gap with open==extend is a linear gap), which is the byte-
+    identity fence: arm-F is only invoked when a genuine discount is present.
+
+    Pure Python (no numba): invoked only on small benchmark panels for the arm-F
+    variant; the production numba/linear kernels are untouched.
+    """
+    Q, R = len(query), len(ref)
+    if Q == 0:
+        return 0.0
+    if R == 0:
+        return float(sum(ins_costs[:Q]))
+    INF = float("inf")
+    q_up = query.upper()
+    r_up = ref.upper()
+
+    # STAIRCASE FIX — run-latch three-state DP.  The gap-OPEN discount carried by
+    # del_open_costs must be collected AT MOST ONCE per maximal homopolymer run.
+    # Query bases inside an HP run match the run base at cost 0, so a naive
+    # affine DP can bounce D -> (free same-base match) -> H -> D and re-collect
+    # the ONE-TIME discount on every deleted in-run base (k*open), degenerating
+    # to the incoherent per-base arm-C cost precisely inside HP runs (the wiring
+    # fault the arbiter found).  We forbid that by splitting the non-deletion
+    # state by a per-run latch:
+    #   H[j]  — not in a deletion, discount for the CURRENT run still AVAILABLE.
+    #   Hs[j] — not in a deletion, discount for the current run already SPENT
+    #           (re-opening a deletion here pays the UNDISCOUNTED del_costs).
+    #   D[j]  — in a deletion.
+    # A genuine run boundary (ref[j-1] != ref[j-2]) RESETS the latch to available,
+    # so two deletions in two DIFFERENT adjacent runs each earn their own run's
+    # discount (junctions sit at run boundaries — this is the case that matters).
+    # Absorbing k bases of ONE run therefore costs open + (k-1)*extend, while
+    # crossing into a fresh run re-arms the discount.  When del_open_costs ==
+    # del_costs (no discount) H and Hs carry equal cost, so the DP collapses to
+    # the linear kernel — the byte-identity fence.
+    def _new_run(j):                       # ref[j-1] begins a new maximal run
+        return j == 1 or r_up[j - 1] != r_up[j - 2]
+
+    H = [INF] * (R + 1)     # available
+    Hs = [INF] * (R + 1)    # spent
+    D = [INF] * (R + 1)
+    H[0] = 0.0
+    # Row i=0: only deletions consume ref (no query, so no match/insert -> H/Hs stay INF).
+    for j in range(1, R + 1):
+        ext = D[j - 1] + del_costs[j - 1]
+        if _new_run(j):
+            src = H[j - 1] if H[j - 1] < Hs[j - 1] else Hs[j - 1]
+            opn = src + del_open_costs[j - 1]
+        else:
+            av = H[j - 1] + del_open_costs[j - 1]     # available -> discounted
+            sp = Hs[j - 1] + del_costs[j - 1]         # spent -> undiscounted
+            opn = av if av < sp else sp
+        D[j] = opn if opn < ext else ext
+
+    for i in range(1, Q + 1):
+        qi = q_up[i - 1]
+        ic = ins_costs[i - 1]
+        Hp, Hsp, Dp = H, Hs, D
+        Hc = [INF] * (R + 1)
+        Hsc = [INF] * (R + 1)
+        Dc = [INF] * (R + 1)
+        # Column 0: only insertions (no ref consumed -> latch unchanged).
+        Hc[0] = Hp[0] + ic
+        Hsc[0] = (Hsp[0] + ic) if Hsp[0] < INF else INF
+        for j in range(1, R + 1):
+            mc = 0.0 if qi == r_up[j - 1] else sub
+            # ---- match/sub (diagonal, row i-1 col j-1) + insertion (row i-1 col j) ----
+            ins_av = Hp[j] + ic                           # avail insertion stays avail
+            up_spent = Hsp[j] if Hsp[j] < Dp[j] else Dp[j]  # spent, or D-exit via insert
+            ins_sp = up_spent + ic
+            if _new_run(j):
+                # matched base begins a NEW run -> latch resets to AVAILABLE
+                d = Hp[j - 1]
+                if Hsp[j - 1] < d:
+                    d = Hsp[j - 1]
+                if Dp[j - 1] < d:
+                    d = Dp[j - 1]
+                match_av = d + mc
+                Hc[j] = match_av if match_av < ins_av else ins_av
+                Hsc[j] = ins_sp                            # no same-run match -> spent only via insert
+            else:
+                match_av = Hp[j - 1] + mc                  # available stays available
+                dsp = Hsp[j - 1] if Hsp[j - 1] < Dp[j - 1] else Dp[j - 1]
+                match_sp = dsp + mc                        # D-exit within run -> spent
+                Hc[j] = match_av if match_av < ins_av else ins_av
+                Hsc[j] = match_sp if match_sp < ins_sp else ins_sp
+            # ---- deletion (current row i, from col j-1) ----
+            ext = Dc[j - 1] + del_costs[j - 1]
+            if _new_run(j):
+                src = Hc[j - 1] if Hc[j - 1] < Hsc[j - 1] else Hsc[j - 1]
+                opn = src + del_open_costs[j - 1]
+            else:
+                av = Hc[j - 1] + del_open_costs[j - 1]
+                sp = Hsc[j - 1] + del_costs[j - 1]
+                opn = av if av < sp else sp
+            Dc[j] = opn if opn < ext else ext
+        H, Hs, D = Hc, Hsc, Dc
+
+    best = INF
+    for j in range(R + 1):
+        v = H[j]
+        if Hs[j] < v:
+            v = Hs[j]
+        if D[j] < v:
+            v = D[j]
+        if v < best:
+            best = v
+    return best
+
+
