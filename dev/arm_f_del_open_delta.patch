index 62b7059..bd9f19e 100644
--- a/rectify/core/splice/hp_penalty.py
+++ b/rectify/core/splice/hp_penalty.py
@@ -429,6 +429,145 @@ def _precompute_del_costs(
     return del_costs
 
 
+# ---------------------------------------------------------------------------
+# C1 length-law gap-OPEN cost precomputation (arm-F: the coherent log-odds law
+# wired into the re-placer as a ONE-TIME gap-open discount, NOT a per-base cost)
+# ---------------------------------------------------------------------------
+
+def _precompute_del_open_costs(
+    ref: str,
+    genome_seq: Optional[str],
+    ref_genome_start: int,
+    ref_genome_rev: bool,
+    del_costs: List[float],
+    del_open_table: "HpPenaltyTable",
+    del_open_lam: float,
+    hp_min_run: int = 4,
+    floor: float = 0.05,
+) -> List[float]:
+    """Precompute per-position ONE-TIME deletion gap-OPEN costs for the affine
+    re-placer DP (:func:`_score_hp_affine_del`).
+
+    This is the faithful wiring of the C1 length-law ``del_open_delta`` into the
+    junction re-placer.  The legacy per-position del cost (``del_costs`` — the
+    flat ``del_hp``/``del_normal`` step, the motif-blind arm-B scale) is the
+    baseline; only the run-length DEPENDENCE ``Δ = λ·ln(rate(hp)/rate(1))`` (zero
+    at hp=1, the coherent baseline-anchored log-odds delta from
+    :meth:`HpPenaltyTable.del_open_delta`) is subtracted, ONCE per deletion run
+    (applied at gap-OPEN), leaving gap-EXTEND on the legacy scale.  This is the
+    minimizing-frame analog of C1's "add Δ to the (negative) gap_open" and is the
+    ONLY coherent partial in a global full-consumption DP (see dev/C1_DESIGN.md).
+
+    Contrast with ``penalty_table.del_cost`` (arm-C), which returns the
+    ``penalty_score`` column (a reciprocal-rate heuristic ≈ c/rate_mean, NOT
+    −logP) and is summed additively per base — incoherent in an additive DP.
+
+    Args mirror :func:`_precompute_del_costs`; ``del_costs`` is that function's
+    output (the extend/legacy scale).  Floored at ``floor`` (> 0) so the gap-open
+    never goes negative (a negative open would make the DP fabricate deletions).
+
+    Returns:
+        List of length ``len(ref)`` with per-position gap-OPEN costs.  When
+        ``del_open_lam == 0`` (or the table has no rate_mean → Δ=0) this equals
+        ``del_costs`` exactly, so the affine DP reduces to the linear DP.
+    """
+    R = len(ref)
+    open_costs: List[float] = []
+    for j in range(R):
+        base = ref[j]
+        gp = (ref_genome_start - j) if ref_genome_rev else (ref_genome_start + j)
+        if genome_seq is not None and 0 <= gp < len(genome_seq):
+            run = _hp_run_length(genome_seq, gp)
+            g_base = genome_seq[gp]
+        else:
+            run = 1
+            kk = j - 1
+            while kk >= 0 and ref[kk] == base:
+                run += 1; kk -= 1
+            kk = j + 1
+            while kk < R and ref[kk] == base:
+                run += 1; kk += 1
+            g_base = base
+        delta = (del_open_table.del_open_delta(run, g_base, del_open_lam)
+                 if del_open_table is not None else 0.0)
+        c = del_costs[j] - delta
+        open_costs.append(c if c > floor else floor)
+    return open_costs
+
+
+def _score_hp_affine_del(
+    query: str,
+    ref: str,
+    del_costs: List[float],
+    del_open_costs: List[float],
+    ins_costs: List[float],
+    sub: float = 1.0,
+) -> float:
+    """Semi-global HP-aware alignment with AFFINE deletions + LINEAR insertions.
+
+    Semantics match :func:`junction_scoring._score_hp_anchored` (left end of ref
+    fixed, right suffix free, returns min total cost over all ref end positions),
+    EXCEPT the deletion dimension is affine: a contiguous run of deleted ref
+    bases costs ``del_open_costs[j0]`` for the first base (gap-OPEN, carrying the
+    C1 log-odds discount) plus ``del_costs[j]`` for each subsequent base
+    (gap-EXTEND, legacy scale).  Opening is only reachable from a NON-deletion
+    state, so the one-time discount cannot be re-collected per base (that would
+    be the incoherent per-base application arm-C exhibits).
+
+    When ``del_open_costs == del_costs`` this reduces EXACTLY to the linear DP
+    (a Gotoh affine gap with open==extend is a linear gap), which is the byte-
+    identity fence: arm-F is only invoked when a genuine discount is present.
+
+    Pure Python (no numba): invoked only on small benchmark panels for the arm-F
+    variant; the production numba/linear kernels are untouched.
+    """
+    Q, R = len(query), len(ref)
+    if Q == 0:
+        return 0.0
+    if R == 0:
+        return float(sum(ins_costs[:Q]))
+    INF = float("inf")
+    q_up = query.upper()
+    r_up = ref.upper()
+
+    # H[j] = best cost of aligning query[:i], ref[:j] ending NOT in a deletion
+    #        (match/sub/insertion); D[j] = best cost ending IN a deletion.
+    H = [INF] * (R + 1)
+    D = [INF] * (R + 1)
+    H[0] = 0.0
+    # Row i=0: only deletions consume ref with no query.
+    for j in range(1, R + 1):
+        openc = H[j - 1] + del_open_costs[j - 1]   # open from non-deletion state
+        extc = D[j - 1] + del_costs[j - 1]          # extend a running deletion
+        D[j] = openc if openc < extc else extc
+
+    for i in range(1, Q + 1):
+        qi = q_up[i - 1]
+        ic = ins_costs[i - 1]
+        Hprev, Dprev = H, D
+        Hcur = [INF] * (R + 1)
+        Dcur = [INF] * (R + 1)
+        best_prev0 = Hprev[0] if Hprev[0] < Dprev[0] else Dprev[0]
+        Hcur[0] = best_prev0 + ic   # column 0: only insertions (no ref)
+        for j in range(1, R + 1):
+            bp_diag = Hprev[j - 1] if Hprev[j - 1] < Dprev[j - 1] else Dprev[j - 1]
+            m = bp_diag + (0.0 if qi == r_up[j - 1] else sub)
+            bp_up = Hprev[j] if Hprev[j] < Dprev[j] else Dprev[j]
+            ins = bp_up + ic
+            Hcur[j] = m if m < ins else ins
+            openc = Hcur[j - 1] + del_open_costs[j - 1]   # open from current-row non-del
+            extc = Dcur[j - 1] + del_costs[j - 1]          # extend current-row deletion
+            Dcur[j] = openc if openc < extc else extc
+        H, D = Hcur, Dcur
+
+    best = INF
+    for j in range(R + 1):
+        v = H[j] if H[j] < D[j] else D[j]
+        if v < best:
+            best = v
+    return best
+
+
