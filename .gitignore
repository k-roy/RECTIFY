# Institution-specific / local SLURM profiles (not for public repo)
rectify/slurm_profiles/local_*.yaml
rectify/slurm_profiles/site_*.yaml

# Beta deployment staging (managed separately via beta worktree)
rectify_beta_deploy/
rectify_new_files/

# Generated caches and indices (large, reproducible)
*.pkl
**/bbmap_index/

# MkDocs site build
site/

# Development test runs (large alignment/correction outputs, not for version control)
dev_runs/
_h2_rebaseline/
scripts/validation_data/rebuild_2026_05/
# ...except test-fixture inputs required by the bundled test suite (CI needs them)
!scripts/validation_data/rebuild_2026_05/trimmed/
!scripts/validation_data/rebuild_2026_05/trimmed/validation_reads_polya_trim_metadata.tsv
scripts/calibration/runs/
docs/figures/*.v2-backup.png
docs/figures/*.v2-backup.svg
rectify/data/validation/**/*.pre_regen

# Diagnostic run outputs; keep reports/scripts/results under scripts/diagnostics
scripts/diagnostics/**/*.bam
scripts/diagnostics/**/*.bai
scripts/diagnostics/**/*.paf
scripts/diagnostics/**/*.fastq
scripts/diagnostics/**/*.sam
scripts/diagnostics/**/*.stderr
scripts/diagnostics/**/*_stderr.txt
scripts/diagnostics/**/qnames_*.txt
scripts/diagnostics/**/ref/

# Large reference data (downloaded separately, not for version control)
rectify/data/*.fsa
rectify/data/*.fsa.fai
rectify/data/*.fsa.amb
rectify/data/*.fsa.ann
rectify/data/*.fsa.bwt
rectify/data/*.fsa.pac
rectify/data/*.fsa.sa
rectify/data/*.gff
rectify/data/*.gtf
rectify/data/*.junc.bed
rectify/data/desalt_index/
**/desalt_index/
# Bundled per-organism directories — heavy artifacts ignored, lightweight
# calibration tables (penalty_tables/) explicitly bundled
rectify/data/genomes/*
!rectify/data/genomes/*/
rectify/data/genomes/*/*
!rectify/data/genomes/*/penalty_tables/
rectify/data/genomes/*/penalty_tables/*
!rectify/data/genomes/*/penalty_tables/*.tsv
!rectify/data/genomes/*/penalty_tables/*.md
!rectify/data/genomes/*/penalty_tables/*.json

# Auto-generated provenance and output data (not source)
rectify/data/README.md
rectify/data/PROVENANCE.json
rectify/data/corrected_3ends.tsv
rectify/data/corrected_3ends_stats.tsv
rectify/data/corrected_3ends_index.bed.gz
rectify/data/output/rectified/*.bedgraph

# Production-scale aligner outputs (large, not bundled validation data)
rectify/data/output/aligners/*.bam
rectify/data/output/aligners/*.bam.bai
rectify/data/output/aligners/*.namesorted.bam

# Generated namesorted BAMs in validation (intermediate, reproducible)
rectify/data/validation/aligners/*.namesorted.bam
rectify/data/output/aligners/*.paf
rectify/data/output/aligners/*.bedgraph
rectify/data/output/aligners/*_junctions.bed
rectify/data/output/aligners/uLTRA_ultra_tmp/
# Re-include the validation_reads-prefixed files (small, bundled test data)
!rectify/data/output/aligners/validation_reads.*.bam
!rectify/data/output/aligners/validation_reads.*.bam.bai
!rectify/data/output/aligners/annotation.junc.bed

# Dev throwaway experiment / repro scripts (underscore-prefixed) + rendered doc previews
dev/_*.py
dev/_*.qsub
*_preview.html
